From 151018c17d7e925a32bee6934f0897b44c499946 Mon Sep 17 00:00:00 2001
From: Adithya R <gh0strider.2k18.reborn@gmail.com>
Date: Wed, 15 Oct 2025 08:16:54 +0530
Subject: [PATCH] sepolicy: Add support for LMOFreeform service

Change-Id: I308176f8b186ecf365e4b98ac792c2f5e9872335
Signed-off-by: Pranav Vashi <neobuddy89@gmail.com>
Signed-off-by: inferno0230 <mail@inferno0230.in>
---
 private/priv_app.te      | 1 +
 private/service.te       | 2 ++
 private/service_contexts | 2 ++
 private/system_server.te | 2 ++
 4 files changed, 7 insertions(+)
 create mode 100644 private/priv_app.te
 create mode 100644 private/service.te
 create mode 100644 private/service_contexts
 create mode 100644 private/system_server.te

diff --git a/private/priv_app.te b/private/priv_app.te
new file mode 100644
index 0000000..d902eb2
--- /dev/null
+++ b/private/priv_app.te
@@ -0,0 +1 @@
+allow priv_app lmo_freeform_service:service_manager find;
diff --git a/private/service.te b/private/service.te
new file mode 100644
index 0000000..5614344
--- /dev/null
+++ b/private/service.te
@@ -0,0 +1,2 @@
+# Freeform
+type lmo_freeform_service, system_api_service, system_server_service, service_manager_type;
diff --git a/private/service_contexts b/private/service_contexts
new file mode 100644
index 0000000..74d9f10
--- /dev/null
+++ b/private/service_contexts
@@ -0,0 +1,2 @@
+# Freeform
+lmo_freeform                              u:object_r:lmo_freeform_service:s0
diff --git a/private/system_server.te b/private/system_server.te
new file mode 100644
index 0000000..b5a0d54
--- /dev/null
+++ b/private/system_server.te
@@ -0,0 +1,2 @@
+# Freeform
+add_service(system_server, lmo_freeform_service);
-- 
2.34.1

